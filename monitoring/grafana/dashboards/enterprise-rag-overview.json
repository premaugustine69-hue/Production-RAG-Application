{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Enterprise RAG Platform",
  "uid": "enterprise-rag-overview",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "FastAPI - Total Requests",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(http_requests_total{job=\"fastapi-ai\"})",
          "legendFormat": "Total Requests"
        }
      ]
    },
    {
      "type": "stat",
      "title": "FastAPI - Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"fastapi-ai\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"fastapi-ai\"}[5m])) * 100",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "type": "graph",
      "title": "FastAPI - Request Latency P99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"fastapi-ai\"}[5m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Enterprise API - JVM Heap Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"enterprise-api\", area=\"heap\"}",
          "legendFormat": "Heap Used"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Redis - Cache Hit Ratio",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total) * 100",
          "legendFormat": "Hit %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "PostgreSQL - Active Connections",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active Connections"
        }
      ]
    },
    {
      "type": "graph",
      "title": "SQS - Ingestion Queue Depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "aws_sqs_approximate_number_of_messages_visible",
          "legendFormat": "Queue Depth"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 36
}
